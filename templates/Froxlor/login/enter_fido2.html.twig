{% extends "Froxlor/base.html.twig" %}

{% block content %}
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 max-w-420 d-flex flex-column">
				<img class="align-self-center my-5" src="{{ header_logo_login }}" alt="froxlor Server Management Panel"/>

				<div class="card shadow">
					<div class="card-body">
						<h5 class="card-title">{{ pagetitle }}</h5>

						{% if message is not empty %}
							<div class="alert alert-danger" role="alert">
								<h4 class="alert-heading">{{ lng('error.error') }}</h4>
								<p>{{ message|raw }}</p>
							</div>
						{% endif %}

						<p>{{ lng('login.fido2_prompt') }}</p>

						<div class="d-flex justify-content-center my-3">
							<i class="bi bi-usb-symbol" style="font-size: 3rem;"></i>
						</div>

						<div id="fido2_status" class="mt-2"></div>

						{% if remember_me %}
						<div class="mb-3 mt-3">
							<div class="form-check form-switch">
								<input type="hidden" name="2fa_remember_val" value="0" id="fido2_remember_hidden"/>
								<input class="form-check-input" type="checkbox" id="fido2_remember" name="fido2_remember">
								<label class="form-check-label" for="fido2_remember">{{ lng('login.2faremember') }}</label>
							</div>
						</div>
						{% endif %}
					</div>

					<div class="card-body d-grid gap-2">
						<button class="btn btn-primary" id="fido2_authenticate_btn" type="button">
							<i class="bi bi-shield-lock me-1"></i>{{ lng('login.fido2_verify') }}
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script>
	// Auto-trigger the authenticator on page load
	window.addEventListener('load', () => triggerFido2());

	document.getElementById('fido2_authenticate_btn').addEventListener('click', () => triggerFido2());

	async function triggerFido2() {
		const statusEl = document.getElementById('fido2_status');
		statusEl.innerHTML = '';

		try {
			// Step 1: Fetch assertion options (challenge + allowed credentials)
			const argsResp = await fetch('index.php?action=fido2_get_args', { method: 'GET' });
			if (!argsResp.ok) throw new Error(await argsResp.text());
			const options = await argsResp.json();
			if (options.error) throw new Error(options.error);

			// Decode base64 fields for the WebAuthn API
			options.challenge = base64urlDecode(options.challenge.data ?? options.challenge);
			if (options.allowCredentials) {
				options.allowCredentials = options.allowCredentials.map(c => ({
					...c, id: base64urlDecode(c.id.data ?? c.id)
				}));
			}

			// Step 2: Let the browser / platform authenticator handle it
			const assertion = await navigator.credentials.get({ publicKey: options });

			// Step 3: Send assertion to server
			const remember = document.getElementById('fido2_remember')?.checked ? '1' : '0';
			const body = new URLSearchParams({
				clientDataJSON:   base64encode(assertion.response.clientDataJSON),
				authenticatorData: base64encode(assertion.response.authenticatorData),
				signature:        base64encode(assertion.response.signature),
				userHandle:       assertion.response.userHandle ? base64encode(assertion.response.userHandle) : '',
				id:               assertion.id,
				'2fa_remember':   remember,
			});

			const verifyResp = await fetch('index.php?action=fido2_verify', {
				method: 'POST',
				headers: {'Content-Type': 'application/x-www-form-urlencoded'},
				body: body
			});
			const result = await verifyResp.json();

			if (result.success) {
				// Server already set the session and sent a redirect header; follow it
				window.location.reload();
			} else if (result.redirect) {
				window.location.href = result.redirect;
			} else {
				throw new Error(result.error ?? 'Authentication failed');
			}
		} catch (err) {
			if (err.name === 'NotAllowedError') {
				statusEl.innerHTML = '<div class="alert alert-warning">{{ lng('login.fido2_cancelled') }}</div>';
			} else {
				statusEl.innerHTML = '<div class="alert alert-danger">' + escHtml(err.message) + '</div>';
			}
		}
	}

	function base64urlDecode(b64) {
		const b = b64.replace(/-/g, '+').replace(/_/g, '/');
		const bin = atob(b);
		return Uint8Array.from(bin, c => c.charCodeAt(0));
	}
	function base64encode(buf) {
		return btoa(String.fromCharCode(...new Uint8Array(buf)));
	}
	function escHtml(str) {
		return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
	}
	</script>
{% endblock %}
